# Copy to .env. Never commit a real key.
# Defaults for new sessions; local users can also configure a model in the UI.
MODEL_API_PROTOCOL=openai
MODEL_API_KEY=
MODEL_NAME=
# Blank uses the official endpoint. Protocols: openai or anthropic.
MODEL_BASE_URL=

# Hosted: a server key funds visitor chats; no key enables visitor-owned settings.
HOSTED_DEMO=false
# Comma-separated allowlist; blank uses official OpenAI and Anthropic API roots.
HOSTED_MODEL_BASE_URLS=

# Blank uses today. Use 2026-03-10 for the historical sample scenario.
DEMO_DATE=
# Exercise the simulated email failure path.
SIMULATE_EMAIL_FAILURE=false

# Direct backend only; Compose sets /data/insurance.db.
# DATABASE_PATH=./data/insurance.db
