# Optional server defaults. You can instead supply your own key in Model settings.
# Never commit a real key. This file is only a template; copy it to .env.
MODEL_API_PROTOCOL=openai
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Protocol: openai for OpenAI-compatible Chat Completions; anthropic for Claude Messages.
# Empty base URL uses the selected protocol's official endpoint:
# openai -> https://api.openai.com/v1
# anthropic -> https://api.anthropic.com/v1
# Set MODEL_BASE_URL explicitly for another compatible service.
# MODEL_NAME must be a model available to your account; there is no model fallback.

# Empty means the actual current date. Use 2026-03-10 only when explicitly
# demonstrating a historical pre-deadline scenario from the synthetic fixtures.
DEMO_DATE=

# Optional test scenario: simulate a failed email send instead of successful outbox storage.
SIMULATE_EMAIL_FAILURE=false

# For running the backend directly (Compose always uses /data/insurance.db).
# DATABASE_PATH=./data/insurance.db
